# Salin file ini menjadi .env, lalu isi API key milikmu.
# Jangan commit file .env atau membagikan key ini ke browser.
AI_BASE_URL=https://rb6kdai.abc-tunnel.us/v1
AI_MODEL=ag/gemini-3.7-flash-high(minimal)
AI_API_KEY=PASTE_YOUR_API_KEY_HERE
AI_TIMEOUT_MS=120000
# Opsional: jika model utama lambat, isi model fallback yang tersedia, dipisahkan koma.
# Contoh: AI_FALLBACK_MODELS=ag/gemini-3.6-flash-low
AI_FALLBACK_MODELS=
