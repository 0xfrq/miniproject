# Salin file ini menjadi .env, lalu isi API key milikmu.
# Jangan commit file .env atau membagikan key ini ke browser.
AI_BASE_URL=https://rb6kdai.abc-tunnel.us/v1
AI_MODEL=ag/gemini-3.7-flash-high(minimal)
AI_API_KEY=PASTE_YOUR_API_KEY_HERE
AI_TIMEOUT_MS=120000
# Opsional: jika model utama lambat, isi model fallback yang tersedia, dipisahkan koma.
# Contoh: AI_FALLBACK_MODELS=ag/gemini-3.6-flash-low
AI_FALLBACK_MODELS=

# PostgreSQL lokal. npm run db:setup membuat koneksi role aplikasi di .env.local.
DATABASE_URL=postgresql://sdn_bangah_app:CHANGE_ME@127.0.0.1:5432/sdn_bangah
# Hanya untuk setup pertama; dihapus otomatis setelah setup berhasil.
# POSTGRES_ADMIN_PASSWORD=kata_sandi_instalasi_postgresql
# ADMIN_EMAIL=admin@sdnbangah.local
# ADMIN_NAME=Administrator
# Aktifkan jika aplikasi dilayani melalui HTTPS.
AUTH_COOKIE_SECURE=false
