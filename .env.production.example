# Copy into .env.local; merge if that file already exists. Replace all placeholders.
# Next.js expands $, so write \$ for literal dollar signs in env files.
# URL-encode special characters in database passwords, for example @ becomes %40.

# LOCAL SETUP ONLY: direct/session-pooler URI from Supabase Connect, port 5432.
MIGRATION_DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_DATABASE_PASSWORD@SESSION_POOLER_HOST:5432/postgres"
ADMIN_EMAIL="admin@your-school.example"
ADMIN_PASSWORD="REPLACE_WITH_UNIQUE_12_TO_128_CHARACTER_PASSWORD"
ADMIN_NAME="Administrator"
APP_DATABASE_ROLE="sdn_bangah_app"
APP_DATABASE_PASSWORD="REPLACE_WITH_UNIQUE_ROLE_PASSWORD_AT_LEAST_24_CHARACTERS"

# RUNTIME: transaction-pooler URI with app role credentials (not postgres).
DATABASE_URL="postgresql://sdn_bangah_app.PROJECT_REF:ENCODED_APP_ROLE_PASSWORD@TRANSACTION_POOLER_HOST:6543/postgres"
DATABASE_SCHEMA="public"
DATABASE_POOL_MODE="transaction"
DATABASE_POOL_MAX="2"
# Optional project CA PEM; literal \n is supported. Do not disable TLS verification.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Legacy service_role JWT from Settings > API Keys. Server only.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_JWT"
SUPABASE_STORAGE_BUCKET="school-images"
AUTH_COOKIE_SECURE="true"
APP_ORIGIN="https://YOUR_PROJECT.vercel.app"

# Use the same provider/models for local indexing and the Vercel runtime.
AI_API_KEY="REPLACE_WITH_PROVIDER_KEY"
AI_BASE_URL="https://YOUR_TRUSTED_PROVIDER/v1"
AI_MODEL="REPLACE_WITH_TEXT_MODEL"
AI_VISION_MODEL="REPLACE_WITH_VISION_MODEL"
AI_EMBEDDING_MODEL="REPLACE_WITH_EMBEDDING_MODEL"
AI_EMBEDDING_DIMENSIONS="768"
AI_TIMEOUT_MS="120000"
AI_FALLBACK_MODELS=""
AI_VISION_FALLBACK_MODELS=""
# BOOKS_CACHE_DIR defaults to /tmp/books on Vercel; leave unset on Windows.
